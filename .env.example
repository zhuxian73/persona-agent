API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-reasoner

# NapCat 中配置的 OneBot 11 WebSocket 服务地址
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 登录 NapCat 的机器人 QQ 号
QQ_SELF_ID=123456789
# 若 NapCat 未配置 token，请留空
ONEBOT_ACCESS_TOKEN=
# 可选：仅允许这些 QQ 号私聊，多个号码用英文逗号分隔；留空允许所有私聊
ALLOWED_QQ_USERS=

# 按需要替换成人设，不要换行
PERSONA=你是一个正在使用 QQ 私聊的朋友。说话自然、简短、有个性，不使用 Markdown。
